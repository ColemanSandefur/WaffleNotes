---
import ContentSection from "@/components/ContentSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { getImage, Image } from "astro:assets";
import ArchivePostCard, {
  type ArchivePostCardProps,
} from "@/components/preact/ArchivePostCard";
import { BookOpenTextIcon } from "@lucide/astro";
import SeriesPartBadge from "@/components/SeriesPartBadge.astro";
import {
  PageDescription,
  PageHeader,
  PageTitle,
} from "@/components/preact/PageTitle";
import {
  Empty,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
  EmptyDescription,
} from "@/components/preact/Empty";
import { DotsSeparator } from "@/components/preact/DotsSeparator";
import Hero from "@/components/Hero.astro";

interface Props {
  series: CollectionEntry<"series">;
}

export async function getStaticPaths() {
  const series = await getCollection("series");
  return series.map((series) => ({
    params: { id: series.id },
    props: { series },
  }));
}

const { series } = Astro.props;
const { Content } = await render(series);

const posts = await getCollection(
  "post",
  (post) => post.data.series?.id === series.id && post.data.draft === false,
).then((value) =>
  value.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()),
);

const searchItems = await Promise.all(
  posts.map(async (post) => {
    const optimizedImage = await getImage({
      src: post.data.coverImage,
      width: 640,
      height: 360,
    });

    return {
      id: post.id,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      coverImage: {
        src: optimizedImage.src,
        srcSet: optimizedImage.srcSet.attribute, // Astro's generated srcset string
        width: 640,
        height: 360,
      },
      tags: post.data.tags,
    } satisfies ArchivePostCardProps;
  }),
);
---

<BaseLayout
  title={series.data.title}
  description={series.data.description}
  image={series.data.coverImage}
  type="article"
  mainClass=""
>
  <Hero
    eyebrow="A Sequential Journey"
    title={series.data.title}
    description={series.data.description}
    image={series.data.coverImage}
  >
    <div class="mt-8 flex flex-row flex-wrap justify-center">
      <SeriesPartBadge
        size="md"
        numPosts={posts.length}
        className={posts.length === 0 ? "bg-background" : ""}
      />
    </div>
  </Hero>
  <ContentSection class="mt-0 pt-16 px-0 bg-background">
    <div class="flex flex-col lg:flex-row flex-wrap">
      <div class="flex-1 px-4">
        <PageHeader className="mt-0">
          <PageTitle>{series.data.title}</PageTitle>
          <PageDescription>
            {series.data.description}
          </PageDescription>
        </PageHeader>

        <div class="flex flex-row flex-wrap mt-4">
          <SeriesPartBadge size="sm" numPosts={posts.length} />
        </div>

        <div class="prose prose-themed post-content mt-8 max-w-full">
          <Content />
        </div>
      </div>
      <DotsSeparator className="my-8 lg:hidden" />
      <div
        class="flex-1 bg-secondary text-secondary-foreground p-4 md:rounded-sm md:mx-4 lg:ml-0 lg:mr-4"
      >
        <h2 class="text-2xl">Lesson Entries</h2>
        <span class="block w-8 border-b-[1.5px] border-secondary-foreground"
        ></span>
        <div class="flex flex-col gap-4 mt-8">
          {
            searchItems.map((post) => (
              <ArchivePostCard
                {...post}
                className="hover:bg-secondary-foreground/85"
              />
            ))
          }
          {
            posts.length === 0 && (
              <Empty className="border border-dashed py-16">
                <EmptyHeader>
                  <EmptyMedia variant="icon">
                    <BookOpenTextIcon />
                  </EmptyMedia>
                  <EmptyTitle>No lessons were found...</EmptyTitle>
                  <EmptyDescription>
                    Please check back later to see the lessons for this series
                  </EmptyDescription>
                </EmptyHeader>
              </Empty>
            )
          }
        </div>
      </div>
    </div>
  </ContentSection>
</BaseLayout>
