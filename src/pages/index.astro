---
import ContentSection from "@/components/ContentSection.astro";
import PostCard from "@/components/PostCard.astro";
import { DotsSeparator } from "@/components/preact/DotsSeparator";
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/preact/Empty";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRightIcon, BookOpenTextIcon, FileTextIcon } from "@lucide/astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { SeriesUtils } from "@/lib/series";
import { formatDate } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";
import SeriesPartBadge from "@/components/SeriesPartBadge.astro";

const posts = await getCollection(
  "post",
  (post) => post.data.draft === false,
).then((value) =>
  value.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
);

const NUM_EXTRA_POSTS = 6;

const firstPost = posts[0];
const morePosts = posts.slice(1, 1 + NUM_EXTRA_POSTS);

const series = await getCollection(
  "series",
  (series) => series.data.draft === false,
);

const latestBySeries = series.reduce(
  (acc, item) => {
    acc[item.id] = SeriesUtils.getLatestPost(item, posts);
    return acc;
  },
  {} as Record<string, CollectionEntry<"post"> | undefined>,
);

series.sort(
  (a, b) =>
    (latestBySeries[b.id]?.data.pubDate.valueOf() ?? 0) -
    (latestBySeries[a.id]?.data.pubDate.valueOf() ?? 0),
);
---

<BaseLayout
  title="Home"
  description="WaffleNotes is a simple space for thoughtful reflections, Bible-centered notes, and encouraging writing associated with the Churches of Christ."
>
  <ContentSection>
    <h2 class="text-2xl text-primary mt-16">Latest Post</h2>
    <span class="block w-8 border-b-[1.5px] border-primary mb-4"></span>
    {
      firstPost ? (
        <div class="grid grid-cols-1 lg:grid-cols-[auto_25rem] gap-4">
          <Image
            src={firstPost.data.coverImage}
            alt={firstPost.data.title}
            width={1200}
            height={675}
            sizes="(min-width: 768px) 80vw, 100vw"
            class="md:col-span-1 rounded-xl"
            loading="eager"
          />
          <div class="flex flex-col gap-4">
            <h1 class="font-serif text-4xl text-primary">
              {firstPost.data.title}
            </h1>
            <p class="text-foreground/70">{firstPost.data.description}</p>
            <a
              href={`/posts/${firstPost.id}`}
              class="col-start-3 underline font-mono text-primary"
            >
              Read Full Post
            </a>
          </div>
        </div>
      ) : (
        <Empty className="border border-dashed py-16">
          <EmptyHeader>
            <EmptyMedia variant="icon">
              <FileTextIcon />
            </EmptyMedia>
            <EmptyTitle>No posts were found...</EmptyTitle>
            <EmptyDescription>
              Please check back later to see some reflections.
            </EmptyDescription>
          </EmptyHeader>
        </Empty>
      )
    }

    <DotsSeparator className="my-16" />

    <h2 class="text-2xl text-primary">Recent Entries</h2>
    <span class="block w-8 border-b-[1.5px] border-primary"></span>

    <div
      class="relative grid sm:grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-8 mt-8"
    >
      {morePosts.map((post) => <PostCard post={post} />)}

      {
        morePosts.length === 0 ? (
          <>
            {/* Blurred skeleton/placeholder cards */}
            {Array.from({ length: 6 }, () => (
              <div class="min-h-48 bg-muted rounded-md select-none pointer-events-none" />
            ))}

            {/* Centered overlay message */}
            <div class="absolute inset-0 flex items-center justify-center z-10">
              <Empty className="border border-dashed py-16 w-fit max-w-md bg-background">
                <EmptyHeader>
                  <EmptyMedia variant="icon">
                    <FileTextIcon />
                  </EmptyMedia>
                  <EmptyTitle>More posts are coming soon...</EmptyTitle>
                  <EmptyDescription>
                    Please check back later to see some more reflections.
                  </EmptyDescription>
                </EmptyHeader>
              </Empty>
            </div>
          </>
        ) : null
      }
    </div>

    <div class="mt-8 flex flex-row justify-center">
      <a
        href="/posts"
        class="px-4 py-2 border border-border rounded-sm text-primary font-mono text-sm w-full sm:w-fit hover:bg-primary/10 flex flex-row justify-center items-center gap-2 transition duration-200 ease-in-out"
      >
        <FileTextIcon class="size-4" />
        Explore More Posts
        <ArrowRightIcon class="size-4" />
      </a>
    </div>

    <DotsSeparator className="my-16" />
  </ContentSection>

  <ContentSection class="px-0">
    <div class="bg-secondary text-secondary-foreground p-4 lg:rounded-sm">
      <h2 class="text-2xl">Recent Series</h2>
      <span class="block w-8 border-b-[1.5px] border-secondary-foreground"
      ></span>

      <div class="relative grid md:grid-cols-2 gap-4 mt-8">
        {
          series.slice(0, 2).map((series) => {
            return (
              <div class="flex flex-col bg-background rounded-sm border border-border p-6">
                <Image
                  src={series.data.coverImage}
                  alt={series.data.title}
                  class="aspect-video object-cover object-center rounded-md"
                />
                <span class="flex flex-row justify-between items-center mt-3">
                  <p class="text-xs font-mono text-primary font-light uppercase">
                    {latestBySeries[series.id]
                      ? formatDate(latestBySeries[series.id]!.data.pubDate)
                      : "Coming Soon..."}
                  </p>
                  <SeriesPartBadge
                    size="sm"
                    numPosts={SeriesUtils.getNumPosts(series, posts)}
                    className="w-fit"
                  />
                </span>
                <h2 class="font-serif text-primary text-xl mt-2">
                  {series.data.title}
                </h2>
                <p class="text-base text-foreground/70 mt-1">
                  {series.data.description}
                </p>
                <a
                  href={`/series/${series.id}`}
                  class="text-sm text-primary font-mono underline flex flex-row items-center gap-2 mt-4"
                >
                  View Series
                  <ArrowRightIcon class="size-3" />
                </a>
              </div>
            );
          })
        }
      </div>
      <div class="mt-8 flex flex-row justify-center">
        <a
          href="/series"
          class="px-4 py-2 border border-border rounded-sm bg-secondary text-secondary-foreground font-mono text-sm w-full sm:w-fit hover:bg-secondary-foreground/10 flex flex-row justify-center items-center gap-2 transition duration-200 ease-in-out"
        >
          <BookOpenTextIcon class="size-4" />
          Explore More Series
          <ArrowRightIcon class="size-4" />
        </a>
      </div>
    </div>
  </ContentSection>
</BaseLayout>
