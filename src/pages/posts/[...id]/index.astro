---
import AudioComponent from "@/components/preact/AudioComponent";
import ContentSection from "@/components/ContentSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import type { InferEntrySchema } from "astro:content";
import { ArrowRightIcon, BookOpenTextIcon, FileTextIcon, TagsIcon } from "@lucide/astro";
import Tag from "@/components/preact/Tag";
import { cn } from "@/lib/utils";
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from "@/components/preact/Empty";

interface Props {
  post: CollectionEntry<"post">;
}

export async function getStaticPaths() {
  const posts = await getCollection("post");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isEmpty = !post.body || post.body.trim().length === 0;

const authorObj = await getEntry(
  post.data.author.collection,
  post.data.author.id,
);

const author =
  authorObj?.data ??
  ({
    name: "Unknown Author",
  } satisfies InferEntrySchema<"author">);

const seriesObj = post.data.series
  ? await getEntry(post.data.series.collection, post.data.series.id)
  : undefined;

const series = seriesObj?.data;

function getInitials(name: string) {
  return name
    .split(" ", 2)
    .map((val) => (val ? val.charAt(0).toLocaleUpperCase() : val))
    .join("");
}

const authorName = author.name;
const authorInitials = getInitials(author.name);
const authorImage = author.avatar;

const coverImage = post.data.coverImage;
const audioUrl = post.data.audioUrl;
const tags = post.data.tags;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={coverImage}
  type="article"
  articleData={{
    publishDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    author: authorName,
  }}
>
  <section
    class="relative isolate flex min-h-[60vh] w-full bg-background overflow-hidden"
  >
    <Image
      src={coverImage}
      alt="Descriptive text"
      width={1920}
      height={1080}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="eager"
    />

    <div
      class="absolute inset-0 -z-10 bg-linear-to-b from-transparent via-background/10 to-background/90"
    />

    <div
      class="background-gradient absolute inset-x-0 bottom-0 h-2/3 backdrop-blur-lg bg-background/70"
    />

    <div class="relative z-10 w-full flex flex-col justify-end pb-6">
      <ContentSection>
        <div class="flex flex-col gap-4">
          <div>
            <h1 class="text-5xl text-foreground">
              {post.data.title}
            </h1>
            <p class="mt-4 text-md text-foreground/70 italic">
              {post.data.description}
            </p>
          </div>
          <span class="block border-b border-b-foreground/25"></span>
          <div class="flex flex-row text-foreground/80 gap-2">
            <div
              class="size-10 flex-none aspect-square bg-primary text-primary-foreground rounded-md flex justify-center items-center font-mono text-2xl"
            >
              {
                authorImage ? (
                  <Image
                    src={authorImage}
                    alt={authorName}
                    width={120}
                    height={120}
                    class="rounded-md object-cover"
                  />
                ) : (
                  <p class="leading-none m-0">{authorInitials}</p>
                )
              }
            </div>
            <div class="flex flex-col">
              <span class="font-mono uppercase text-xs text-primary"
                >Written by</span
              >
              <p class="">{authorName}</p>
            </div>
            <div class="flex flex-col ml-auto text-right">
              <span class="font-mono uppercase text-xs text-primary"
                >Published</span
              >
              <p class="">{post.data.pubDate.toDateString()}</p>
            </div>
          </div>
        </div>
      </ContentSection>
    </div>
  </section>

  <ContentSection>
    {
      (series || audioUrl) && (
        <Fragment>
          <div class="flex flex-col gap-2 mt-2">
            {
              series && (
                <div class="p-2 flex flex-col sm:flex-row gap-2 gap-y-4 rounded-sm border border-border">
                  <div class="flex flex-row gap-2">
                    <div class="size-10 aspect-square rounded-md bg-primary text-primary-foreground flex justify-center items-center text-2xl">
                      <BookOpenTextIcon />
                    </div>
                    <div class="flex flex-col">
                      <span class="font-mono text-xs text-muted-foreground">
                        This lesson is part of a series:
                      </span>
                      <p class="font-serif text-base text-primary">{series.title}</p>
                    </div>
                  </div>
                  <div class="flex flex-col ml-auto justify-center w-full sm:w-fit">
                    <a
                      href=`/series/${seriesObj.id}`
                      class="bg-primary text-primary-foreground rounded-md grow-0 py-2 px-3 text-sm sm:w-fit flex flex-row items-center justify-center sm:justify-start"
                    >
                      View Series
                      <ArrowRightIcon class="size-4 ml-2"/>
                    </a>
                  </div>
                </div>
              )
            }
            {
              audioUrl && (
                <AudioComponent client:load src={audioUrl} />
              )
            }
          </div>
          <div class="flex flex-row justify-center gap-8 text-sm text-primary my-8">
            <span>•</span>
            <span>•</span>
            <span>•</span>
          </div>
        </Fragment>
      )
    }
    <div class={cn("mt-12", {"prose prose-themed post-content": !isEmpty})}>
      {
        !isEmpty ? (
          <Content />
        ) : (
          <Empty className="border border-dashed py-16">
            <EmptyHeader>
              <EmptyMedia variant="icon">
                <FileTextIcon />
              </EmptyMedia>
              <EmptyTitle>Coming Soon...</EmptyTitle>
              <EmptyDescription>
                This content is currently being written. Please check back later.
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        )
      }
    </div>
    {tags.length > 0 && (
      <div class="border-border border-t flex flex-row gap-4 pt-8 mt-16">
        <div class="flex flex-row flex-wrap gap-2">
          {tags.map((tag) => (<Tag className="text-primary">{tag}</Tag>))}
        </div>
      </div>
    )}
  </ContentSection>
</BaseLayout>

<style>
  .background-gradient {
    -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
  }
</style>