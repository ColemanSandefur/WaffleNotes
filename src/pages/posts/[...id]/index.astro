---
import AudioComponent from "@/components/preact/AudioComponent";
import ContentSection from "@/components/ContentSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import type { InferEntrySchema } from "astro:content";
import { FileTextIcon } from "@lucide/astro";
import Tag from "@/components/preact/Tag";
import { cn } from "@/lib/utils";
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/preact/Empty";
import { SeriesReference } from "@/components/preact/SeriesReference";
import { DotsSeparator } from "@/components/preact/DotsSeparator";

interface Props {
  post: CollectionEntry<"post">;
}

export async function getStaticPaths() {
  const posts = await getCollection("post");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isEmpty = !post.body || post.body.trim().length === 0;

const authorObj = await getEntry(
  post.data.author.collection,
  post.data.author.id,
);

const author =
  authorObj?.data ??
  ({
    name: "Unknown Author",
  } satisfies InferEntrySchema<"author">);

const seriesObj = post.data.series
  ? await getEntry(post.data.series.collection, post.data.series.id)
  : undefined;

const series = seriesObj?.data;

function getInitials(name: string) {
  return name
    .split(" ", 2)
    .map((val) => (val ? val.charAt(0).toLocaleUpperCase() : val))
    .join("");
}

const authorName = author.name;
const authorInitials = getInitials(author.name);
const authorImage = author.avatar;

const coverImage = post.data.coverImage;
const audioUrl = post.data.audioUrl;
const tags = post.data.tags;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={coverImage}
  type="article"
  articleData={{
    publishDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    author: authorName,
  }}
>
  <section
    class="relative isolate flex min-h-[60vh] w-full bg-background overflow-hidden"
  >
    <Image
      src={coverImage}
      alt="Descriptive text"
      width={1920}
      height={1080}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="eager"
    />

    <div
      class="absolute inset-0 -z-10 bg-linear-to-b from-transparent via-background/10 to-background/90"
    >
    </div>

    <div
      class="background-gradient absolute inset-x-0 bottom-0 h-2/3 backdrop-blur-lg bg-background/70"
    >
    </div>

    <div class="relative z-10 w-full flex flex-col justify-end pb-6">
      <ContentSection width="prose">
        <div class="flex flex-col gap-4">
          <div>
            <h1 class="text-5xl text-foreground">
              {post.data.title}
            </h1>
            <p class="mt-4 text-md text-foreground/70 italic">
              {post.data.description}
            </p>
          </div>
          <span class="block border-b border-b-foreground/25"></span>
          <div class="flex flex-row text-foreground/80 gap-2">
            <div
              class="size-10 flex-none aspect-square bg-primary text-primary-foreground rounded-md flex justify-center items-center font-mono text-2xl"
            >
              {
                authorImage ? (
                  <Image
                    src={authorImage}
                    alt={authorName}
                    width={120}
                    height={120}
                    class="rounded-md object-cover"
                  />
                ) : (
                  <p class="leading-none m-0">{authorInitials}</p>
                )
              }
            </div>
            <div class="flex flex-col">
              <span class="font-mono uppercase text-xs text-primary"
                >Written by</span
              >
              <p class="">{authorName}</p>
            </div>
            <div class="flex flex-col ml-auto text-right">
              <span class="font-mono uppercase text-xs text-primary"
                >Published</span
              >
              <p class="">{post.data.pubDate.toDateString()}</p>
            </div>
          </div>
        </div>
      </ContentSection>
    </div>
  </section>

  <ContentSection width="prose" class="mt-6">
    <div class="flex flex-col gap-2">
      {series && <SeriesReference seriesId={seriesObj.id} series={series} />}
      {audioUrl && <AudioComponent client:load src={audioUrl} />}
    </div>
    {(series || audioUrl) && <DotsSeparator className="my-8" />}
    <div class="mt-8 prose prose-themed post-content">
      {
        !isEmpty ? (
          <Content />
        ) : (
          <Empty className="border border-dashed py-16 not-prose">
            <EmptyHeader>
              <EmptyMedia variant="icon">
                <FileTextIcon />
              </EmptyMedia>
              <EmptyTitle>Coming Soon...</EmptyTitle>
              <EmptyDescription>
                This content is currently being written. Please check back
                later.
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        )
      }
    </div>
    {
      tags.length > 0 && (
        <div class="border-border border-t flex flex-row gap-4 pt-8 mt-16">
          <div class="flex flex-row flex-wrap gap-2">
            {tags.map((tag) => (
              <Tag className="text-primary">{tag}</Tag>
            ))}
          </div>
        </div>
      )
    }
  </ContentSection>
</BaseLayout>

<style>
  .background-gradient {
    -webkit-mask-image: linear-gradient(
      to top,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    mask-image: linear-gradient(
      to top,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0) 100%
    );
  }
</style>
